{
  "uid": "o12-stress",
  "title": "012 stress runs",
  "description": "make stress results over time (stress.results)",
  "tags": [
    "012"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Engine: edit latency by topology",
      "description": "BenchmarkEdit: one Set and its incremental recalc, per run (log scale)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT ts AS time, name, ns_op / 1e6 AS ms FROM stress.results FINAL WHERE $__timeFilter(ts) AND match(name, '^Edit/') ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "always",
            "spanNulls": true,
            "scaleDistribution": {
              "type": "log",
              "log": 10
            },
            "pointSize": 6
          },
          "displayName": "${__field.labels.name}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "UI: frame and keystroke time",
      "description": "Whole frames (View, parse, diff) and key presses through to their frame (log scale)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT ts AS time, name, ns_op / 1e6 AS ms FROM stress.results FINAL WHERE $__timeFilter(ts) AND match(name, '^(Frame/(dense-8192x256|longtext-8192x500|charts-20)/200x60|Keystroke/(arrow/dense-8192x256|extend-data/dense-8192x256|type/fanin-1000)/80x24)$') ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "always",
            "spanNulls": true,
            "scaleDistribution": {
              "type": "log",
              "log": 10
            },
            "pointSize": 6
          },
          "displayName": "${__field.labels.name}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Full recalc and file operations",
      "description": "RecalcAll per topology, native save and open of 2.1M cells, CSV imports (log scale)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT ts AS time, name, ns_op / 1e6 AS ms FROM stress.results FINAL WHERE $__timeFilter(ts) AND match(name, '^(RecalcAll/|Save/dense-8192x256|Open/dense-8192x256|Import/(owid|airport))') ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "always",
            "spanNulls": true,
            "scaleDistribution": {
              "type": "log",
              "log": 10
            },
            "pointSize": 6
          },
          "displayName": "${__field.labels.name}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory per cell",
      "description": "Live heap per non-blank cell after loading",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT ts AS time, name, metrics['B/cell'] AS bytes_per_cell FROM stress.results FINAL WHERE $__timeFilter(ts) AND mapContains(metrics, 'B/cell') ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "always",
            "spanNulls": true,
            "pointSize": 6
          },
          "displayName": "${__field.labels.name}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Latest run against the previous one",
      "description": "Changes over 10% and 2 us; positive is slower (a regression)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT pkg, name, round(before_ns / 1e6, 3) AS before_ms, round(after_ns / 1e6, 3) AS after_ms, round(change * 100, 1) AS change_pct FROM stress.latest_vs_previous WHERE abs(change) > 0.10 AND abs(after_ns - before_ns) > 2000 ORDER BY change DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Runs",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT run_id, min(ts) AS ts, any(git_sha) AS sha, max(git_dirty) AS dirty, any(cpu) AS cpu, any(go_version) AS go, count() AS benchmarks FROM stress.results FINAL GROUP BY run_id ORDER BY ts DESC LIMIT 20",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}