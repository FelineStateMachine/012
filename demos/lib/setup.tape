# Shared settings for every demo: a fixed window, the dark reference
# palette the golden screens use (e2e/palette_test.go), and a pace that
# reads well. Tapes run from demos/, so the binary is ../bin/012.
Set Shell "bash"
Set FontSize 16
Set Width 1000
Set Height 600
Set Padding 20
Set LineHeight 1.15
Set TypingSpeed 55ms
Set CursorBlink false
Set Theme { "name": "012 dark", "background": "#1d1f21", "foreground": "#c5c8c6", "cursor": "#c5c8c6", "selection": "#373b41", "black": "#1d1f21", "red": "#cc6666", "green": "#b5bd68", "yellow": "#f0c674", "blue": "#81a2be", "magenta": "#b294bb", "cyan": "#8abeb7", "white": "#c5c8c6", "brightBlack": "#666666", "brightRed": "#d54e53", "brightGreen": "#b9ca4a", "brightYellow": "#e7c547", "brightBlue": "#7aa6da", "brightMagenta": "#c397d8", "brightCyan": "#70c0b1", "brightWhite": "#eaeaea" }
